# MongoDB connection string (MongoDB Atlas works well with Hostinger)
MONGO_URI=mongodb://127.0.0.1:27017/mahaad

# Long random string used to sign login sessions (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public URL of the site, with https:// and no trailing slash (SEO links, sitemap, emails, CORS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Folder for photos uploaded in the dashboard. Default: <project>/uploads
# On Hostinger put it OUTSIDE the app folder so a redeploy can't delete photos, e.g.
#   UPLOAD_DIR=/home/u123456789/mahaad-uploads
# UPLOAD_DIR=

# ---------- Email (contact form) ----------
# Easiest: set this up in Dashboard → Settings → Email (saved encrypted in the database).
# The values below are only used until email settings are saved in the dashboard.
# Optional: separate key for encrypting the SMTP password (defaults to JWT_SECRET; changing it means re-entering the password)
# EMAIL_SECRET=
# Hostinger email: hPanel → Emails → your mailbox → "Configure devices" shows these values.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# SMTP_SECURE=true          # optional; defaults to true for port 465, false otherwise (587 uses STARTTLS)
SMTP_USER=info@your-domain.com
SMTP_PASS=
# Sender address (defaults to SMTP_USER) and name shown in the inbox
MAIL_FROM=info@your-domain.com
MAIL_FROM_NAME=MA HAAD School & College
# Who receives contact-form messages — one or more, comma-separated
ADMIN_EMAIL=info@your-domain.com
